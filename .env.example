SECRET_KEY=your_secret_key_here
COOKIE_SECURE=False
ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_HOSTS=["localhost","127.0.0.1"]
TRUSTED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Production overlay uses this domain for TLS, host and CSRF configuration.
SITE_DOMAIN=print.example.com
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000
MAX_FILE_SIZE_MB=20
MAX_PDF_PAGES=1000
MIN_FREE_UPLOAD_MB=1024

POSTGRES_USER=printeaseadmin
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=printease
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

RAZORPAY_API_KEY=your_razorpay_key
RAZORPAY_API_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

WEB3FORMS_ACCESS_KEY=your_web3forms_key
CURRENCY=INR

# Secret token used by printer-pc to authenticate against the server
AGENT_TOKEN=your_secure_agent_token_here
